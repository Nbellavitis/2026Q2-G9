# Copiar como terraform.tfvars para cambiar algún valor por defecto. Ninguno es obligatorio: con
# los valores por defecto, Terraform despliega en cualquier cuenta del Learner Lab.

# region                      = "us-east-1"
# project                     = "q"
# api_stage_name              = "prod"
# log_retention_days          = 14
# access_logs_expiration_days = 30
# site_throttle_rate_limit    = 500
# site_throttle_burst_limit   = 1000
# api_throttle_rate_limit     = 25
# api_throttle_burst_limit    = 50
# joins_per_minute            = 60

# Mails. En el pipeline salen de las variables del repositorio SES_SENDER_EMAIL,
# SES_VERIFIED_RECIPIENTS y ALERT_EMAIL, y cada dirección tiene que confirmar el link que manda AWS
# después del apply. En el Learner Lab solo sirve ALERT_EMAIL (es SNS): el lab niega SES, y con las
# otras dos el apply falla al crear las identidades.
# ses_sender_email        = "queue.cloud.itba@gmail.com"
# ses_verified_recipients = ["integrante@gmail.com"]
# email_alertas           = "queue.cloud.itba@gmail.com"
