# Loaded by `next build`. Defining the flag here rather than leaving it unset is what makes the
# demo credentials disappear: with no value, Next emits a runtime `process.env` lookup instead of a
# literal, so nothing can be eliminated and the credentials survive in the bundle even though the
# block never renders. Given "false", the condition folds to a constant and the whole block - array
# included - is dropped.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
